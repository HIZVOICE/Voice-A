# FinaSU v1.5.0 (HIZVOICE/FinaSU @ fbf8e00) -> Linux 4.14 compat patch
# (Voice-A v2, camellia). FinaSU is written for 5.10+ in the places below;
# this patch version-gates them for the 4.14 arm64 ABI. C-only, minimal.
#
# The 4.14 ABI class: on 4.17+ syscall handlers take `const struct pt_regs
# *regs`; on 4.14 they take raw args (fd in x0, buf in x1, ...). The v2 phone
# test bootlooped because ksu_sys_fstat dereferenced fd 3 as a pointer.
# Fixed: ksu_sys_read/fstat (direct args), filter_init_module/finit_module
# (direct args), ksu_syscall_dispatcher (recovers pt_regs via
# current_pt_regs()), the orig_* pointers, and the sucompat orig-syscall
# calls (now via ksu_call_orig_syscall(), which unpacks six args from regs
# on < 4.17 — the same helper shape SukiSU-Ultra uses). The tracepoint path
# (ksu_sys_enter_handler) is untouched: tracepoints pass a real pt_regs.
# Also: preinit clone3 -> clone, SELinux policy ports, assorted version
# gates (see the per-file hunks). KSU_VERSION 33174, Tracepoint backend,
# manager signature (slot 2) unchanged.
#
# PT_REAL_REGS gate (found by the FinaSU v2 phone test, 2026-11-09 — the
# kernel booted and ran Android, but opening the manager app called reboot
# and the reboot_handler_pre kprobe faulted at +0x18 dereferencing magic1
# 0xfee1dead as a pt_regs pointer): on < 4.17 PT_REAL_REGS(regs) is now
# (regs) — the kprobe's regs already hold the syscall args.
#
diff --git a/kernel/core/init.c b/kernel/core/init.c
index c6c1e41e..24ffe5f2 100644
--- a/kernel/core/init.c
+++ b/kernel/core/init.c
@@ -337,8 +337,12 @@ module_exit(kernelsu_exit);
 MODULE_LICENSE("GPL");
 MODULE_AUTHOR("weishu");
 MODULE_DESCRIPTION("Android KernelSU");
+/* MODULE_IMPORT_NS exists only on 5.4+; on 4.14 the VFS symbols are not
+   namespaced, so the import is a no-op and must be skipped. */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 4, 0)
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 13, 0)
 MODULE_IMPORT_NS("VFS_internal_I_am_really_a_filesystem_and_am_NOT_a_driver");
 #else
 MODULE_IMPORT_NS(VFS_internal_I_am_really_a_filesystem_and_am_NOT_a_driver);
 #endif
+#endif
