+/* 4.14 compat: invoke the original syscall handler for table slot @nr.
+ * On 4.17+ the table entries take pt_regs, so call them directly. On 4.14
+ * they take raw args — unpack all six from regs (the callee ignores the
+ * extras). Calling a 4.14 table entry with a pt_regs pointer would pass the
+ * pt_regs address as the first syscall argument (e.g. execve's filename),
+ * so the direct call is wrong on 4.14 and must go through here. */
+#if defined(__aarch64__) && LINUX_VERSION_CODE < KERNEL_VERSION(4, 17, 0)
+static inline long ksu_call_orig_syscall(int nr, const struct pt_regs *regs)
+{
+    typedef long (*ksu_syscall_6_t)(unsigned long, unsigned long, unsigned long,
+                                    unsigned long, unsigned long, unsigned long);
+    ksu_syscall_6_t fn = (ksu_syscall_6_t)READ_ONCE(ksu_syscall_table[nr]);
+    return fn(PT_REGS_SYSCALL_PARM1(regs), PT_REGS_PARM2(regs), PT_REGS_PARM3(regs),
+              PT_REGS_SYSCALL_PARM4(regs), PT_REGS_PARM5(regs), PT_REGS_PARM6(regs));
+}
+#else
+static inline long ksu_call_orig_syscall(int nr, const struct pt_regs *regs)
+{
+    return ksu_syscall_table[nr](regs);
+}
+#endif
