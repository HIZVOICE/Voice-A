# SukiSU-Ultra MAIN: KSU-side SUSFS wiring (SUSFS v2.3.0 kernel patch companion)
#
# Main branch has NO KSU-side SUSFS wiring (its extension/susfs.c is a stub
# returning -EOPNOTSUPP; no CONFIG_KSU_SUSFS Kconfig; no ksu_handle_sys_reboot;
# no susfs_is_current_ksu_domain). The builtin branch (refs/heads/builtin)
# HAS the full wiring; this patch ports it to main, adapted where main
# differs from builtin. The SUSFS kernel patch itself
# (susfs-4.14-v2.3.0-camellia.patch) provides fs/susfs.c + the fs hooks.
#
# Sources, per file:
#  kernel/Kconfig — the 10 CONFIG_KSU_SUSFS_* symbols, FinaSU Kconfig text
#    verbatim (proven 1:1 match with what the v2.3.0 patch references).
#    Inserted before endmenu. Top symbol default n; features default y.
#  kernel/supercall/dispatch.c — ksu_handle_sys_reboot, adapted from
#    builtin's dispatch.c. TWO deliberate differences from builtin:
#    (a) magic2 == KSU_INSTALL_MAGIC2 returns 0 (FinaSU's handling):
#        main's kprobe in supercall.c installs the fd; main has NO
#        ksu_supercall_reboot_handler function to call.
#    (b) CMD_SUSFS_SET_PRIORITY_UID_FILTER case OMITTED: v2.4.0-only,
#        the v2.3.0 kernel patch has no susfs_set_priority_uid_filter.
#  kernel/selinux/selinux.c — susfs sid vars + susfs_set_sid +
#    susfs_is_sid_equal + susfs_get_sid_from_name + susfs_get_current_sid
#    + susfs_set_batch_sid + the 5 susfs_is_current_*_domain helpers,
#    adapted from builtin. Main has no current_sid(), so the current-SID
#    read is a local static susfs_current_sid() (same pattern as main's
#    is_sid_match / FinaSU's current_selinux_sid).
#  kernel/selinux/selinux.h — the externs + prototypes (builtin + FinaSU).
#  kernel/selinux/rules.c — susfs_set_batch_sid() after each
#    reset_avc_cache() at the 4 policy-install sites (2 functions x
#    >=5.0 / 4.14 branches), exactly as in FinaSU/builtin.
#
# Apply to kernel/KernelSU AFTER the v3-compat patch (step 5c), before
# the build. Verified: git apply --check clean against SukiSU-Ultra main
# v4.3.0-r2 (645ef9860b9b) as vendored in sukisu-ultra-src/.
#
diff --git a/kernel/Kconfig b/kernel/Kconfig
--- a/kernel/Kconfig
+++ b/kernel/Kconfig
@@ -61,4 +61,94 @@
 	  Dynamically patch x64's hardened syscall dispatcher to support syscall hooks. This is a
 	  replacement for a kernel source code patch, and is useful for x86_64 LKM mode.
 
+config KSU_SUSFS
+	bool "KernelSU addon - SUSFS"
+	depends on KSU=y
+	depends on THREAD_INFO_IN_TASK
+	default n
+	help
+	  Compile the KernelSU side of the SUSFS interface. The SUSFS kernel
+	  implementation still has to be applied to the kernel tree, and
+	  KernelSU has to be built in rather than loaded as a module.
+
+config KSU_SUSFS_SUS_PATH
+	bool "Enable to hide suspicious path"
+	depends on KSU_SUSFS
+	default y
+	help
+	  Hide a user-defined path and everything below it from the system calls
+	  SUSFS intercepts. Prefer add_sus_path_loop for paths that change often.
+	  Only applies to app processes spawned from zygote that carry the
+	  TIF_PROC_UMOUNTED mark. Costs performance and is not immune to
+	  side-channel probing.
+
+config KSU_SUSFS_SUS_MOUNT
+	bool "Enable to hide suspicious mounts"
+	depends on KSU_SUSFS
+	default y
+	help
+	  Give mounts created by the su process fake mount ids until /sdcard is
+	  decrypted, and hide SUSFS mounts from /proc/self/[mounts|mountinfo|mountstat]
+	  for non-su processes. Only applies to app processes spawned from zygote
+	  that carry the TIF_PROC_UMOUNTED mark.
+
+config KSU_SUSFS_SUS_KSTAT
+	bool "Enable to spoof suspicious kstat"
+	depends on KSU_SUSFS
+	default y
+	help
+	  Report spoofed stat data for user-defined paths. Applies to processes
+	  whose uid modulo 100000 is at least 10000.
+
+config KSU_SUSFS_SPOOF_UNAME
+	bool "Enable to spoof uname"
+	depends on KSU_SUSFS
+	default y
+	help
+	  Return a user-defined string from uname. Applies to all processes.
+
+config KSU_SUSFS_ENABLE_LOG
+	bool "Enable logging susfs log to kernel"
+	depends on KSU_SUSFS
+	default y
+	help
+	  Write SUSFS diagnostics to the kernel log. Disable to silence all
+	  SUSFS logging.
+
+config KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS
+	bool "Enable to automatically hide ksu and susfs symbols from /proc/kallsyms"
+	depends on KSU_SUSFS
+	default y
+	help
+	  Hide KernelSU and SUSFS symbols from /proc/kallsyms for all processes.
+
+config KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
+	bool "Enable to spoof /proc/bootconfig (gki) or /proc/cmdline (non-gki)"
+	depends on KSU_SUSFS
+	default y
+	help
+	  Replace /proc/bootconfig on GKI kernels, or /proc/cmdline on non-GKI
+	  kernels, with the contents of a user-defined file. Applies to all
+	  processes.
+
+config KSU_SUSFS_OPEN_REDIRECT
+	bool "Enable to redirect a path to be opened with another path"
+	depends on KSU_SUSFS
+	default y
+	help
+	  Open a user-defined path in place of another one. Both paths must exist
+	  when the rule is added, and SELinux permissions for both sides remain
+	  the caller's responsibility. Only applies to processes using the
+	  predefined uid scheme.
+
+config KSU_SUSFS_SUS_MAP
+	bool "Enable to hide some mmapped real file from different proc maps interfaces"
+	depends on KSU_SUSFS
+	default y
+	help
+	  Hide the backing file of mmapped regions from
+	  /proc/<pid>/[maps|smaps|smaps_rollup|map_files|mem|pagemap]. Anonymous
+	  mappings are not covered, and hooks placed by the injected library
+	  itself are not hidden. Only applies to zygote-spawned app processes
+	  that carry the TIF_PROC_UMOUNTED mark.
 endmenu
